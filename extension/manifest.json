{
  "manifest_version": 3,
  "name": "Prospect Reach",
  "version": "0.2.0",
  "description": "Download the prospects template, upload a filled sheet, review it, and send personalized outreach through Gmail/Mailsuite.",
  "permissions": ["storage", "downloads", "sidePanel", "scripting"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Prospect Reach",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
